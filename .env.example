# jira-alerts-mcp — example configuration
#
# NOTE: the server does NOT read this file. There is no dotenv dependency, by
# design: an MCP server is launched by its client, and the client owns the
# environment. Use this file as a reference for what to put in your MCP
# client's `env` block, or source it for local development:
#
#     set -a; source .env; set +a
#     npm run dev
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Required -------------------------------------------------------------

# Atlassian site cloud id (a UUID). Find it at:
#   https://<your-site>.atlassian.net/_edgeAuth/tenantInfo
# or via GET https://api.atlassian.com/oauth/token/accessible-resources
JSM_CLOUD_ID=00000000-0000-0000-0000-000000000000

# --- Authentication: pick ONE of the two blocks below ---------------------

# Option A — Atlassian account API token (HTTP Basic).
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JSM_EMAIL=you@example.com
JSM_API_TOKEN=your-atlassian-api-token

# Option B — OAuth 3LO / Forge bearer token. Takes precedence if set, in which
# case JSM_EMAIL and JSM_API_TOKEN are ignored.
# JSM_OAUTH_TOKEN=your-oauth-access-token

# --- Optional -------------------------------------------------------------

# Transport: "stdio" (default, for MCP clients) or "http".
# TRANSPORT=stdio

# HTTP transport bind settings. Defaults to loopback deliberately: this
# process holds credentials and should not listen on all interfaces without a
# conscious decision.
# HOST=127.0.0.1
# PORT=3000

# Comma-separated Host header allowlist for the HTTP transport. Loopback
# binding alone does not stop a web page in your browser POSTing to this port
# (DNS rebinding) — Host validation does. It is applied automatically for
# loopback hosts; if you set HOST beyond loopback you must set this too.
# ALLOWED_HOSTS=mcp.internal.example.com
